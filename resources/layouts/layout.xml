<layout id="MainLayout">

    <!-- Clock time labels (split for string lookup optimization) -->
    <label id="ClockHH" x="26%" y="19%" font="Graphics.FONT_NUMBER_MEDIUM" justification="Graphics.TEXT_JUSTIFY_CENTER|Graphics.TEXT_JUSTIFY_VCENTER" color="Graphics.COLOR_WHITE" />
    <label id="ClockColon1" x="38%" y="19%" font="Graphics.FONT_NUMBER_MEDIUM" justification="Graphics.TEXT_JUSTIFY_CENTER|Graphics.TEXT_JUSTIFY_VCENTER" color="Graphics.COLOR_WHITE" text=":" />
    <label id="ClockMM" x="50%" y="19%" font="Graphics.FONT_NUMBER_MEDIUM" justification="Graphics.TEXT_JUSTIFY_CENTER|Graphics.TEXT_JUSTIFY_VCENTER" color="Graphics.COLOR_WHITE" />
    <label id="ClockColon2" x="62%" y="19%" font="Graphics.FONT_NUMBER_MEDIUM" justification="Graphics.TEXT_JUSTIFY_CENTER|Graphics.TEXT_JUSTIFY_VCENTER" color="Graphics.COLOR_WHITE" text=":" />
    <label id="ClockSS" x="74%" y="19%" font="Graphics.FONT_NUMBER_MEDIUM" justification="Graphics.TEXT_JUSTIFY_CENTER|Graphics.TEXT_JUSTIFY_VCENTER" color="Graphics.COLOR_WHITE" />

    <drawable id="Divider1" class="DividerDrawable">
        <param name="yPercent">32</param>
        <param name="height">6</param>
    </drawable>

    <!-- Countdown row WITH hours (smaller font: +H:MM:SS) -->
    <label id="CountdownHoursSign" x="8%" y="48%" font="Graphics.FONT_NUMBER_HOT" justification="Graphics.TEXT_JUSTIFY_CENTER|Graphics.TEXT_JUSTIFY_VCENTER" color="Graphics.COLOR_WHITE" />
    <label id="CountdownHoursHH" x="30%" y="48%" font="Graphics.FONT_NUMBER_HOT" justification="Graphics.TEXT_JUSTIFY_RIGHT|Graphics.TEXT_JUSTIFY_VCENTER" color="Graphics.COLOR_WHITE" />
    <label id="CountdownHoursColon1" x="33%" y="48%" font="Graphics.FONT_NUMBER_HOT" justification="Graphics.TEXT_JUSTIFY_CENTER|Graphics.TEXT_JUSTIFY_VCENTER" color="Graphics.COLOR_WHITE" text=":" />
    <label id="CountdownHoursMM" x="50%" y="48%" font="Graphics.FONT_NUMBER_HOT" justification="Graphics.TEXT_JUSTIFY_CENTER|Graphics.TEXT_JUSTIFY_VCENTER" color="Graphics.COLOR_WHITE" />
    <label id="CountdownHoursColon2" x="67%" y="48%" font="Graphics.FONT_NUMBER_HOT" justification="Graphics.TEXT_JUSTIFY_CENTER|Graphics.TEXT_JUSTIFY_VCENTER" color="Graphics.COLOR_WHITE" text=":" />
    <label id="CountdownHoursSS" x="70%" y="48%" font="Graphics.FONT_NUMBER_HOT" justification="Graphics.TEXT_JUSTIFY_LEFT|Graphics.TEXT_JUSTIFY_VCENTER" color="Graphics.COLOR_WHITE" />

    <!-- Countdown row WITHOUT hours (larger font: +M:SS) -->
    <label id="CountdownMinutesSign" x="13%" y="48%" font="Graphics.FONT_NUMBER_THAI_HOT" justification="Graphics.TEXT_JUSTIFY_CENTER|Graphics.TEXT_JUSTIFY_VCENTER" color="Graphics.COLOR_WHITE" />
    <label id="CountdownMinutesMM" x="50%" y="48%" font="Graphics.FONT_NUMBER_THAI_HOT" justification="Graphics.TEXT_JUSTIFY_RIGHT|Graphics.TEXT_JUSTIFY_VCENTER" color="Graphics.COLOR_WHITE" />
    <label id="CountdownMinutesColon" x="55%" y="48%" font="Graphics.FONT_NUMBER_THAI_HOT" justification="Graphics.TEXT_JUSTIFY_CENTER|Graphics.TEXT_JUSTIFY_VCENTER" color="Graphics.COLOR_WHITE" text=":" />
    <label id="CountdownMinutesSS" x="60%" y="48%" font="Graphics.FONT_NUMBER_THAI_HOT" justification="Graphics.TEXT_JUSTIFY_LEFT|Graphics.TEXT_JUSTIFY_VCENTER" color="Graphics.COLOR_WHITE" />
    
    <drawable id="HighlightCountdown" class="HighlightDrawable">
        <param name="xPercent">50</param>
        <param name="yPercent">50</param>
        <param name="widthPercent">90</param>
        <param name="heightPercent">30</param>
        <param name="penWidth">4</param>
        <param name="radius">5</param>
    </drawable>

    <drawable id="Divider2" class="DividerDrawable">
        <param name="yPercent">68</param>
        <param name="height">6</param>
    </drawable>

    <label id="TargetHH" x="26%" y="80%" font="Graphics.FONT_NUMBER_MEDIUM" justification="Graphics.TEXT_JUSTIFY_CENTER|Graphics.TEXT_JUSTIFY_VCENTER" color="Graphics.COLOR_WHITE" />
    <label id="TargetColon1" x="38%" y="80%" font="Graphics.FONT_NUMBER_MEDIUM" justification="Graphics.TEXT_JUSTIFY_CENTER|Graphics.TEXT_JUSTIFY_VCENTER" color="Graphics.COLOR_WHITE" text=":" />
    <label id="TargetMM" x="50%" y="80%" font="Graphics.FONT_NUMBER_MEDIUM" justification="Graphics.TEXT_JUSTIFY_CENTER|Graphics.TEXT_JUSTIFY_VCENTER" color="Graphics.COLOR_WHITE" />
    <label id="TargetColon2" x="62%" y="80%" font="Graphics.FONT_NUMBER_MEDIUM" justification="Graphics.TEXT_JUSTIFY_CENTER|Graphics.TEXT_JUSTIFY_VCENTER" color="Graphics.COLOR_WHITE" text=":" />
    <label id="TargetSS" x="74%" y="80%" font="Graphics.FONT_NUMBER_MEDIUM" justification="Graphics.TEXT_JUSTIFY_CENTER|Graphics.TEXT_JUSTIFY_VCENTER" color="Graphics.COLOR_WHITE" />

    <drawable id="HighlightHH" class="HighlightDrawable">
        <param name="xPercent">26</param>
        <param name="yPercent">81</param>
        <param name="widthPercent">20</param>
        <param name="heightPercent">20</param>
        <param name="penWidth">2</param>
        <param name="radius">3</param>
    </drawable>
    <drawable id="HighlightMM" class="HighlightDrawable">
        <param name="xPercent">50</param>
        <param name="yPercent">81</param>
        <param name="widthPercent">20</param>
        <param name="heightPercent">20</param>
        <param name="penWidth">2</param>
        <param name="radius">3</param>
    </drawable>
    <drawable id="HighlightSS" class="HighlightDrawable">
        <param name="xPercent">74</param>
        <param name="yPercent">81</param>
        <param name="widthPercent">20</param>
        <param name="heightPercent">20</param>
        <param name="penWidth">2</param>
        <param name="radius">3</param>
    </drawable>
</layout>
